{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.getmcpads/pinterest-ads",
  "title": "Pinterest Ads",
  "description": "Pinterest Ads: 26 read tools and 5 write tools that preview before they apply.",
  "version": "1.0.1",
  "websiteUrl": "https://www.getmcpads.com/tools/pinterest-ads",
  "repository": {
    "url": "https://github.com/getmcpads-com/pinterest-ads-mcp-server",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@getmcpads/pinterest-ads-mcp-server",
      "version": "1.0.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "PINTEREST_ACCESS_TOKEN",
          "description": "Pinterest access token with the ads:read scope.",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "PINTEREST_REFRESH_TOKEN",
          "description": "Refresh token, so the server can renew the access token.",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "PINTEREST_APP_ID",
          "description": "App ID, needed for refresh.",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "PINTEREST_APP_SECRET",
          "description": "App secret, needed for refresh.",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "PINTEREST_AD_ACCOUNT_ID",
          "description": "Default ad account ID.",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "PINTEREST_ENABLE_WRITES",
          "description": "Set to 1 to register the 5 write tools.",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
